# =====================================================================
# Twenty CRM — Variables d'environnement
# Copier en .env (jamais commit !)
# =====================================================================

# --- Domaine public (CRUCIAL — sans ça rien ne marche) ---
# Ex: https://twenty.codteam.dz ou https://votre-app.up.railway.app
SERVER_URL=https://twenty.example.com

# --- Sécurité ---
# Générer avec : openssl rand -hex 32
APP_SECRET=

# --- Base de données ---
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=
PG_DATABASE_NAME=default

# --- Port (3000 par défaut) ---
PORT=3000

# --- Email (optionnel, pour invitations équipe) ---
# Si vous voulez activer l'envoi d'emails d'invitation :
# EMAIL_FROM_ADDRESS=noreply@codteam.dz
# EMAIL_FROM_NAME=COD Team
# EMAIL_DRIVER=smtp
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=

# --- Storage (par défaut local, ou S3) ---
# STORAGE_TYPE=s3
# STORAGE_S3_REGION=eu-west-3
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
