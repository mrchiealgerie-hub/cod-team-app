# =====================================================================
# wacrm-baileys-relay — environment variables
# Copy to .env, then fill in. Never commit .env to git.
# =====================================================================

# --- Supabase ---
SUPABASE_URL=https://sfsnyppydvhvnjiqjgjt.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# --- Supabase bot user (must be a real Supabase Auth user with admin role) ---
# Create one in Dashboard -> Authentication -> Add user, then in SQL Editor:
#   update public.profiles set role='admin' where id=(select id from auth.users where email='wabot@yourdomain.com');
SUPABASE_BOT_EMAIL=wabot@yourdomain.com
SUPABASE_BOT_PASSWORD=long-random-password-here

# --- Relay HTTP auth ---
# Generate a long random token (e.g. `openssl rand -hex 32`)
# Used to protect the /status, /logout, /test endpoints.
RELAY_AUTH_TOKEN=

# --- Server ---
PORT=3000
CORS_ORIGINS=https://mrchiealgerie-hub.github.io

# --- Throttling (RECOMMENDED — reduces ban risk) ---
# Min/max delay between two sends, in milliseconds (random within range)
SEND_DELAY_MIN_MS=8000
SEND_DELAY_MAX_MS=15000
# Hard caps to avoid red flags on WhatsApp side
MAX_PER_HOUR=120
MAX_PER_DAY=500

# --- Worker ---
POLL_INTERVAL_MS=8000

# --- Storage paths (persistent volume on Railway/Render) ---
AUTH_DIR=/data/auth_info_baileys

# --- Logging ---
LOG_LEVEL=warn
